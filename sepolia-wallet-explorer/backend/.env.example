# Ethereum Sepolia JSON-RPC Endpoint (Alchemy, Infura, QuickNode, or Public RPC)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Maximum concurrent block fetch requests to the RPC provider
RPC_CONCURRENCY=5

# Maximum allowed block range per scan request (Default: 50)
MAX_BLOCK_RANGE=50

# Server Port (Default: 3001)
PORT=3001
